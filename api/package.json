{
  "name": "backend",
  "module": "index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test --env-file=`if [ \"$NODE_ENV\" == \"production\" ]; then echo \".env.production\"; else echo \".env.development\"; fi`"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.3.2",
    "@elysiajs/static": "^1.3.0",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.3.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.3.6",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.39.3",
    "drizzle-typebox": "^0.3.3",
    "firebase-admin": "^13.4.0",
    "mysql2": "^3.14.3"
  },
  "override": {
    "@sinclair/typebox": "0.34.0"
  }
}
